{
    "appearance": {
        "deformScale": 0,
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "desktopClock": {
            "background": {
                "blur": true,
                "enabled": true,
                "opacity": 0.7
            },
            "enabled": true,
            "shadow": {
                "blur": 0.4,
                "enabled": true,
                "opacity": 0.7
            }
        },
        "enabled": true,
        "visualiser": {
            "autoHide": true,
            "enabled": true
        },
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": false,
            "inverted": false,
            "showOnHover": false
        },
        "clock": {
            "background": false,
            "showDate": true,
            "showIcon": true
        },
        "persistent": true,
        "popouts": {
            "activeWindow": true,
            "statusIcons": true,
            "tray": true
        },
        "scrollActions": {
            "brightness": true
        },
        "showOnHover": true,
        "statusIcons": [
            {
                "enabled": true,
                "id": "lockStatus"
            },
            {
                "enabled": true,
                "id": "audio"
            },
            {
                "enabled": true,
                "id": "kbLayout"
            },
            {
                "enabled": true,
                "id": "network"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "battery"
            }
        ],
        "tray": {
            "background": true,
            "compact": false,
            "recolour": true
        },
        "workspaces": {
            "activeIndicator": true,
            "activeTrail": true,
            "occupiedBg": false,
            "perMonitorWorkspaces": true,
            "showWindows": false,
            "showWindowsOnSpecialWorkspaces": false,
            "shown": 6
        }
    },
    "dashboard": {
        "showDashboard": true
    },
    "general": {
        "apps": {
            "audio": [
                "hyprpwcenter"
            ],
            "explorer": [
                "nautilus",
                "--new-window"
            ],
            "playback": [
                "mpv",
                "--player-operation-mode=pseudo-gui",
                "--"
            ],
            "terminal": [
                "kitty"
            ]
        },
        "idle": {
            "inhibitWhenAudio": true,
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "idleAction": "lock",
                    "timeout": 1800
                }
            ]
        },
        "logo": "caelestia"
    },
    "launcher": {
        "enableDangerousActions": false,
        "favouriteApps": [
            "zen"
        ],
        "maxWallpapers": 5,
        "useFuzzy": {
            "actions": true,
            "apps": true,
            "schemes": false,
            "variants": false,
            "wallpapers": false
        },
        "vimKeybinds": false
    },
    "notifs": {
        "fullscreen": "On",
        "openExpanded": true
    },
    "osd": {
        "enableMicrophone": true
    },
    "paths": {
        "mediaGif": "~/.config/caelestia/2b.gif",
        "sessionGif": "root:/assets/kurukuru.gif",
        "wallpaperDir": "~/Pictures/Wallpapers"
    },
    "services": {
        "defaultPlayer": "Spotify",
        "maxVolume": 1.5,
        "smartScheme": true,
        "useFahrenheit": false,
        "useTwelveHourClock": false
    },
    "session": {
        "commands": {
            "logout": [
                "caelestia",
                "shell",
                "lock",
                "lock"
            ],
            "reboot": [
                "hyprshutdown",
                "-t",
                "Restarting...",
                "--post-cmd",
                "reboot"
            ],
            "shutdown": [
                "hyprshutdown",
                "-t",
                "Shutting down...",
                "--post-cmd",
                "shutdown -P 0"
            ]
        },
        "icons": {
            "hibernate": "downloading",
            "logout": "lock",
            "reboot": "cached",
            "shutdown": "power_settings_new"
        }
    },
    "sidebar": {
        "dragThreshold": 80
    },
    "utilities": {
        "cards": {
            "quickToggles": true
        },
        "enabled": true,
        "quickToggles": [
            {
                "enabled": true,
                "id": "wifi"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "mic"
            },
            {
                "enabled": true,
                "id": "settings"
            },
            {
                "enabled": true,
                "id": "gameMode"
            },
            {
                "enabled": true,
                "id": "dnd"
            },
            {
                "enabled": true,
                "id": "vpn"
            }
        ]
    }
}
