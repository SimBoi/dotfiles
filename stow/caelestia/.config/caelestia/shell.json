{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "desktopClock": {
            "background": {
                "blur": true,
                "enabled": true,
                "opacity": 0.7
            },
            "enabled": true,
            "shadow": {
                "blur": 0.4,
                "enabled": true,
                "opacity": 0.7
            }
        },
        "enabled": true,
        "visualiser": {
            "autoHide": true,
            "enabled": true
        },
        "wallpaperEnabled": true
    },
    "bar": {
        "persistent": true,
        "popouts": {
            "tray": true
        },
        "showOnHover": true,
        "status": {
            "showAudio": true,
            "showBattery": true,
            "showBluetooth": true,
            "showKbLayout": true,
            "showLockStatus": true,
            "showMicrophone": true,
            "showNetwork": true,
            "showWifi": true
        },
        "tray": {
            "background": true,
            "compact": false,
            "recolour": true
        },
        "workspaces": {
            "activeIndicator": true,
            "activeTrail": true,
            "occupiedBg": false,
            "perMonitorWorkspaces": true,
            "showWindows": false,
            "showWindowsOnSpecialWorkspaces": true,
            "shown": 6
        }
    },
    "dashboard": {
        "showDashboard": true
    },
    "general": {
        "apps": {
            "audio": [
                "hyprpwcenter"
            ],
            "explorer": [
                "nautilus",
                "--new-window"
            ],
            "playback": [
                "mpv",
                "--player-operation-mode=pseudo-gui",
                "--"
            ],
            "terminal": [
                "/usr/bin/ghostty",
                "--gtk-single-instance=true",
                "-e"
            ]
        },
        "idle": {
            "inhibitWhenAudio": true,
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "idleAction": "lock",
                    "timeout": 1800
                }
            ]
        },
        "logo": "caelestia"
    },
    "launcher": {
        "enableDangerousActions": false,
        "favouriteApps": [
            "zen"
        ],
        "maxWallpapers": 5,
        "useFuzzy": {
            "actions": true,
            "apps": true,
            "schemes": false,
            "variants": false,
            "wallpapers": false
        },
        "vimKeybinds": false
    },
    "notifs": {
        "fullscreen": "on",
        "openExpanded": true
    },
    "osd": {
        "enableMicrophone": true
    },
    "paths": {
        "mediaGif": "~/.config/caelestia/2b.gif",
        "sessionGif": "root:/assets/kurukuru.gif",
        "wallpaperDir": "~/Pictures/Wallpapers"
    },
    "services": {
        "defaultPlayer": "Spotify",
        "maxVolume": 1.5,
        "smartScheme": true,
        "useFahrenheit": false,
        "useTwelveHourClock": false
    },
    "session": {
        "commands": {
            "logout": [
                "caelestia",
                "shell",
                "lock",
                "lock"
            ],
            "reboot": [
                "hyprshutdown",
                "-t",
                "Restarting...",
                "--post-cmd",
                "reboot"
            ],
            "shutdown": [
                "hyprshutdown",
                "-t",
                "Shutting down...",
                "--post-cmd",
                "shutdown -P 0"
            ]
        },
        "icons": {
            "hibernate": "downloading",
            "logout": "lock",
            "reboot": "cached",
            "shutdown": "power_settings_new"
        }
    }
}
