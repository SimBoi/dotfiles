{
    "general": {
        "logo": "caelestia",
        "apps": {
            "terminal": ["ghostty"],
            "audio": ["pavucontrol"],
            "playback": ["mpv"],
            "explorer": ["nautilus"]
        },
        "idle": {
            "lockBeforeSleep": true,
            "inhibitWhenAudio": true,
            "timeouts": [
                {
                    "timeout": 1800,
                    "idleAction": "lock"
                }
            ]
        }
    },
    "background": {
        "enabled": true,
        "desktopClock": {
            "enabled": true,
            "background": {
                "enabled": true,
                "opacity": 0.7,
                "blur": true
            },
            "shadow": {
                "enabled": true,
                "opacity": 0.7,
                "blur": 0.4
            }
        }
    },
    "bar": {
        "workspaces": {
            "shown": 6
        },
        "tray": {
            "background": true,
            "recolour": true,
            "compact": false
        },
        "status": {
            "showAudio": true,
            "showMicrophone": true,
            "showKbLayout": true,
            "showNetwork": true,
            "showWifi": true,
            "showBluetooth": true,
            "showBattery": true,
            "showLockStatus": true
        }
    },
    "launcher": {
        "maxWallpapers": 5,
        "vimKeybinds": true,
        "useFuzzy": {
            "apps": true,
            "actions": true,
            "schemes": false,
            "variants": false,
            "wallpapers": false
        }
    },
    "notifs": {
        "openExpanded": true
    },
    "session": {
        "commands": {
            "logout": [
                "caelestia",
                "shell",
                "lock",
                "lock"
            ]
        }
    },
    "services": {
        "useFahrenheit": false,
        "useTwelveHourClock": false,
        "maxVolume": 1.5,
        "smartScheme": true,
        "defaultPlayer": "Spotify"
    },
    "paths": {
        "wallpaperDir": "~/Pictures/Wallpapers",
        "sessionGif": "root:/assets/kurukuru.gif",
        "mediaGif": "~/.config/caelestia/2b.gif"
    }
}
