{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "desktopClock": {
            "background": {
                "blur": true,
                "enabled": true,
                "opacity": 0.7
            },
            "enabled": true,
            "shadow": {
                "blur": 0.4,
                "enabled": true,
                "opacity": 0.7
            }
        },
        "enabled": true,
        "visualiser": {
            "autoHide": true,
            "enabled": true
        },
        "wallpaperEnabled": true
    },
    "bar": {
        "status": {
            "showAudio": true,
            "showBattery": true,
            "showBluetooth": true,
            "showKbLayout": true,
            "showLockStatus": true,
            "showMicrophone": true,
            "showNetwork": true,
            "showWifi": true
        },
        "tray": {
            "background": true,
            "compact": false,
            "recolour": true
        },
        "workspaces": {
            "activeIndicator": true,
            "activeTrail": true,
            "occupiedBg": false,
            "perMonitorWorkspaces": true,
            "showWindows": false,
            "showWindowsOnSpecialWorkspaces": true,
            "shown": 6
        }
    },
    "dashboard": {
        "showDashboard": true
    },
    "general": {
        "apps": {
            "audio": [
                "pavucontrol"
            ],
            "explorer": [
                "nautilus"
            ],
            "playback": [
                "mpv"
            ],
            "terminal": [
                "ghostty"
            ]
        },
        "idle": {
            "inhibitWhenAudio": true,
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "idleAction": "lock",
                    "timeout": 1800
                }
            ]
        },
        "logo": "caelestia"
    },
    "launcher": {
        "enableDangerousActions": true,
        "maxWallpapers": 5,
        "useFuzzy": {
            "actions": true,
            "apps": true,
            "schemes": false,
            "variants": false,
            "wallpapers": false
        },
        "vimKeybinds": false
    },
    "notifs": {
        "openExpanded": true
    },
    "osd": {
        "enableMicrophone": true
    },
    "paths": {
        "mediaGif": "~/.config/caelestia/2b.gif",
        "sessionGif": "root:/assets/kurukuru.gif",
        "wallpaperDir": "~/Pictures/Wallpapers"
    },
    "services": {
        "defaultPlayer": "Spotify",
        "maxVolume": 1.5,
        "smartScheme": true,
        "useFahrenheit": false,
        "useTwelveHourClock": false
    },
    "session": {
        "commands": {
            "logout": [
                "caelestia",
                "shell",
                "lock",
                "lock"
            ]
        }
    }
}
